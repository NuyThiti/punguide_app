// Every configuration passes dart_defines.json, which is gitignored and holds
// MAPS_API_KEY. Dart cannot read ios/Flutter/Secrets.xcconfig, so without a
// --dart-define the map falls back to its "not configured" plate even though
// the native SDKs have the key. Copy dart_defines.example.json to
// dart_defines.json to get started.
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "punguide_app",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json"
            ]
        },
        {
            "name": "punguide_app (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json"
            ]
        },
        {
            "name": "punguide_app (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=dart_defines.json"
            ]
        }
    ]
}
